{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "lib": ["ES2020"],
    "types": [],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "herdr": [".cache/herdr-sdk/herdr.d.ts"] }
  },
  "include": ["src/**/*.ts", ".cache/herdr-sdk/gpui-kit.d.ts"]
}
