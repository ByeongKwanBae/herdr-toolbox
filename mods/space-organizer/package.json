{
  "name": "@herdr-toolbox/space-organizer",
  "version": "0.0.1-dev.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "scripts": {
    "sdk:sync": "node scripts/sdk.mjs sync",
    "sdk:verify": "node scripts/sdk.mjs verify",
    "typecheck": "npm run sdk:verify && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .cache/tests/tests/*.test.js",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "check:app": "node scripts/check-app.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.27.7",
    "typescript": "5.9.3"
  }
}
